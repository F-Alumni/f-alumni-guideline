# ==============================================================================
# FPT Alumni Connect — Demo Environment Configuration (.env.example)
# Copy this file to docker/.env: cp docker/.env.example docker/.env
# ==============================================================================

# Database Configuration (SQL Server 2022)
MSSQL_SA_PASSWORD=YourStrong@Passw0rd!
SQL_SERVER_HOST_PORT=14333

# Kafka Broker Configuration (KRaft Mode - No Zookeeper)
KAFKA_HOST_PORT=29092
KAFKA_CONTAINER_PORT=9092

# Service Ports (Host-facing mappings)
GATEWAY_PORT=5000
CHAT_API_PORT=5002
USER_GRPC_PORT=50051

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Development
