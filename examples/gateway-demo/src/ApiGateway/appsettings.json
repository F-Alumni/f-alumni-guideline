{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "user-route-v1": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/v1/users/{**remainder}"
        }
      },
      "user-auth-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**remainder}"
        }
      },
      "chat-route-v1": {
        "ClusterId": "chat-cluster",
        "Match": {
          "Path": "/api/v1/chats/{**remainder}"
        }
      },
      "chat-route-short": {
        "ClusterId": "chat-cluster",
        "Match": {
          "Path": "/api/chat/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/v1/chats/{**remainder}"
          }
        ]
      },
      "chat-hub-route": {
        "ClusterId": "chat-cluster",
        "Match": {
          "Path": "/hubs/chat/{**remainder}"
        }
      },
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/v1/admin/{**remainder}"
        }
      },
      "forum-posts-route": {
        "ClusterId": "forum-cluster",
        "Match": {
          "Path": "/api/v1/posts/{**remainder}"
        }
      },
      "forum-comments-route": {
        "ClusterId": "forum-cluster",
        "Match": {
          "Path": "/api/v1/comments/{**remainder}"
        }
      },
      "forum-events-route": {
        "ClusterId": "forum-cluster",
        "Match": {
          "Path": "/api/v1/events/{**remainder}"
        }
      },
      "forum-categories-route": {
        "ClusterId": "forum-cluster",
        "Match": {
          "Path": "/api/v1/categories/{**remainder}"
        }
      },
      "forum-reports-route": {
        "ClusterId": "forum-cluster",
        "Match": {
          "Path": "/api/v1/reports/{**remainder}"
        }
      },
      "forum-bookmarks-route": {
        "ClusterId": "forum-cluster",
        "Match": {
          "Path": "/api/v1/bookmarks/{**remainder}"
        }
      },
      "forum-hub-route": {
        "ClusterId": "forum-cluster",
        "Match": {
          "Path": "/hubs/forum/{**remainder}"
        }
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/api/v1/ai/{**remainder}"
        }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "chat-cluster": {
        "Destinations": {
          "chat-service": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "forum-cluster": {
        "Destinations": {
          "forum-service": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "ai-service": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "admin-cluster": {
        "Destinations": {
          "admin-service": {
            "Address": "http://localhost:5005"
          }
        }
      }
    }
  }
}
