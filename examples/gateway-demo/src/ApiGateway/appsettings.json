{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "user-route-auth": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**remainder}"
        }
      },
      "user-route-users": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/v1/users/{**remainder}"
        }
      },
      "user-route-internal": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/v1/internal/{**remainder}"
        }
      },
      "user-route-short": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/v1/users/{**remainder}"
          }
        ]
      },
      "chat-route-v1": {
        "ClusterId": "chat-cluster",
        "Match": {
          "Path": "/api/v1/chats/{**remainder}"
        }
      },
      "chat-route-short": {
        "ClusterId": "chat-cluster",
        "Match": {
          "Path": "/api/chat/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/v1/chats/{**remainder}"
          }
        ]
      },
      "chat-hub-route": {
        "ClusterId": "chat-cluster",
        "Match": {
          "Path": "/hubs/chat/{**remainder}"
        }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "chat-cluster": {
        "Destinations": {
          "chat-service": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  }
}
