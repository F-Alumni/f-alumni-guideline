{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "chat-route-v1": {
        "ClusterId": "chat-cluster",
        "Match": {
          "Path": "/api/v1/chats/{**remainder}"
        }
      },
      "chat-route-short": {
        "ClusterId": "chat-cluster",
        "Match": {
          "Path": "/api/chat/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/v1/chats/{**remainder}"
          }
        ]
      }
    },
    "Clusters": {
      "chat-cluster": {
        "Destinations": {
          "chat-service": {
            "Address": "http://chat-service:5002"
          }
        }
      }
    }
  }
}
